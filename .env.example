# Copy to .env.local with `pnpm env:local`. Blank values fall back to the
# defaults in src/lib/env/server.ts.

# An API implementing the notes contract (e2e/mock-api/openapi.json), e.g.
# `pnpm mock:api`. Server-side only: the browser calls /api on this site,
# which forwards to this address.
API_URL=http://localhost:4000
# Time budgets in milliseconds (service contract: 10 s each), both counted
# from the start of a request. Every backend call from this server:
API_REQUEST_TIMEOUT_MS=10000
# Reading a request body the /api proxy forwards (bodies are capped at 1 MiB):
API_BODY_TIMEOUT_MS=10000

# Public origin of this site: canonical URLs, sitemap, Open Graph.
SITE_URL=http://localhost:3000

# Release identifier, sent as the x-app-version header and in /health/*.
APP_VERSION=dev

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# index | noindex, read at runtime. Stage sets noindex: robots.txt disallows
# everything and pages say noindex. The image is the same for stage and prod.
ROBOTS=index

# Not read by the app: the OpenAPI document `pnpm api:types` generates types
# from (URL or file). Default: e2e/mock-api/openapi.json.
# OPENAPI_URL=http://localhost:4000/openapi.json

# Google Tag Manager container (GTM-ABC1234); empty: no tag manager.
GTM_ID=
